# Copy this file to backend/.env and fill in your own values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# true gives detailed error pages from FastAPI. Keep false outside development.
DEBUG=false

# PostgreSQL database with the pgvector extension available.
DATABASE_URL=postgresql+psycopg2://smartaccess:change-me@localhost:5432/smartaccess

# Signs the admin login tokens (JWT, HS256). Changing it logs out every admin.
SECRET_KEY=change-me

# Shared secret with the edge device. Must be identical to DEVICE_API_KEY in edge-device/.env.
DEVICE_API_KEY=change-me
