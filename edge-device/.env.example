# Copy this file to edge-device/.env and fill in your own values.

# Name of this device. Stored in the access log for every approved entry.
DEVICE_ID=gate-1

# Must be identical to DEVICE_API_KEY in backend/.env.
DEVICE_API_KEY=change-me

# Base address of the backend, as seen from the device.
BACKEND_URL=http://127.0.0.1:8000
